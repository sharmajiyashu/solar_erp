APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

WEBSITE_MOBILE="+012 345 6789"
WEBSITE_MAP_URL="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3444.6094622176214!2d75.8243657!3d30.3051052!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x39104f7c23a5cf09%3A0x9ff8178cd5b03f0e!2sSolar%20Tec%20Solutions!5e0!3m2!1sen!2sin!4v1710490000000!5m2!1sen!2sin"

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# For real-time ticket chat (set to pusher and add keys from pusher.com):
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=mt1
# --- Firebase (Admin SDK: Kreait) — path to service account JSON (relative to project root or absolute) ---
# FIREBASE_PROJECT=app
# FIREBASE_CREDENTIALS=storage/app/firebase-adminsdk.json
# GCP/Firebase project id (same as in JSON "project_id") — for FcmDispatcher HTTP v1 fallback
# FIREBASE_PROJECT_ID=
# Same as above (legacy alias):
# FIREBASE_CREDENTIALS_PATH=storage/app/firebase-adminsdk.json
# Realtime Database URL (Console → Realtime Database → copy URL, e.g. https://xxx-default-rtdb.firebaseio.com)
# FIREBASE_DATABASE_URL=
#
# --- Firebase Web (Console → Project settings → Your apps → Web) — ticket chat + browser FCM ---
# FIREBASE_WEB_API_KEY=
# FIREBASE_WEB_AUTH_DOMAIN=
# FIREBASE_WEB_PROJECT_ID=
# FIREBASE_WEB_STORAGE_BUCKET=
# FIREBASE_WEB_MESSAGING_SENDER_ID=
# FIREBASE_WEB_APP_ID=
# FIREBASE_WEB_MEASUREMENT_ID=
# Web Push (FCM): optional but recommended — Cloud Messaging → Web Push certificates → Key pair (public key)
# FIREBASE_WEB_VAPID_KEY=
#
# Optional: FCM HTTP v1 fallback (see config/services.php `fcm`); Admin SDK can also send via Kreait.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
